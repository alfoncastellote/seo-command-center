# SEO Visibility Panel
# Copy to .env for local runs, or set these in Coolify as environment variables.

# Required — DataForSEO API credentials (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your_api_password

# Required — the key you type on the login page
ACCESS_KEY=pick-something-strong
# Optional — cookie signing secret (falls back to a value derived from ACCESS_KEY)
SESSION_SECRET=another-long-random-string

# Optional
BRAND_NAME=SEO Visibility
HOST=0.0.0.0
PORT=8000
DATA_DIR=/app/data
CONCURRENCY=8
